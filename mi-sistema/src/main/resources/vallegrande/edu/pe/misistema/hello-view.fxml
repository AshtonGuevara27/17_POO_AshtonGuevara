<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="vallegrande.edu.pe.misistema.controller.MainController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>

    <Label text="Registro de Contactos (JavaFX + MySQL)" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Email:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="txtEmail" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Asunto:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtAsunto" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Label text="Mensaje:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextArea fx:id="txtMensaje" prefRowCount="2" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2"/>
    </GridPane>

    <Button text="Registrar Contacto" onAction="#onRegistrar" style="-fx-background-color: #2563eb; -fx-text-fill: white;"/>

    <TableView fx:id="tablaContactos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="120"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="150"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="90"/>
            <TableColumn fx:id="colAsunto" text="Asunto" prefWidth="120"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="80"/>
        </columns>
    </TableView>
</VBox>